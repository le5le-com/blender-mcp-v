# MCP server transport (sse serves MCP + the login callback over HTTP)
MCP_TRANSPORT=sse
MCP_HOST=0.0.0.0
MCP_PORT=8080

# Blender addon socket server
BLENDER_HOST=localhost
BLENDER_PORT=9876

# le5le account login
BLENDERMCP_LOGIN_URL="https://account.le5le.com/login"
BLENDERMCP_PROFILE_URL="https://v.le5le.com/api/account/profile"
# Override when the MCP server is not on the user's machine:
# BLENDERMCP_AUTH_CALLBACK_URL="http://localhost:8080/auth/callback"
# BLENDERMCP_AUTH_PORT=8080

# Model upload endpoint (the login token is used as bearer token
# when BLENDERMCP_UPLOAD_TOKEN is not set)
BLENDERMCP_UPLOAD_URL="https://account.le5le.com/api/file/upload"
# BLENDERMCP_UPLOAD_TOKEN=""
